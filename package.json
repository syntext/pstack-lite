{
  "name": "pstack-opencode",
  "version": "0.1.0",
  "description": "Native OpenCode V2 plugin adapting Lauren Tan's pstack engineering skills and agents",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./server": "./index.js"
  },
  "files": [
    "index.js",
    "plugin/",
    "agents/",
    "skills/",
    "!skills/**/node_modules/",
    "!skills/**/*.test.ts",
    "!skills/**/*.test-helper.ts",
    "LICENSE",
    "README.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test scripts/*.test.mjs",
    "test:integration": "node --test scripts/integration/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.18",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.2"
  }
}
